# Copy to .env.local and fill in the values from Firebase console →
# Project settings → General → Your apps → firebaseConfig.
# These values are not secret; the Firestore security rules protect the data.
# Without them the app runs in local-only mode (localStorage), exactly as before.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
