{
  "name": "wine-cellar-management",
  "private": true,
  "version": "1.0.0",
  "homepage": "https://uhrigjanis.github.io/WineCellarManagement",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "dev:emulator": "vite --host 0.0.0.0 --mode emulator",
    "emulators": "npx --yes firebase-tools@15 emulators:start --project demo-weinkeller",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project demo-weinkeller-rules \"node --test emulator-tests/firestore.rules.spec.js\""
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "^0.4.2",
    "firebase": "^13.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^6.4.6"
  }
}
