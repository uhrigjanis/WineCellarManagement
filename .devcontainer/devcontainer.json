{
  "name": "WineCellarManagement",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "postCreateCommand": "npm ci",
  "postAttachCommand": {
    "dev-server": "npm run dev"
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Wine Cellar (Vite)",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
