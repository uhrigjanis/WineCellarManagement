# Used by `npm run dev:emulator` (vite --mode emulator). Talks to the local Firebase Emulator Suite
# (`npm run emulators`) with the demo project `demo-weinkeller` – no real Firebase project involved.
VITE_FIREBASE_USE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-weinkeller
# Optional: host of the machine running the emulators. Defaults to the host the page was loaded from,
# so opening http://<your-LAN-IP>:5173 on a phone also reaches the emulators.
# VITE_FIREBASE_EMULATOR_HOST=192.168.1.20
