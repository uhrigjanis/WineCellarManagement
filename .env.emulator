# Used by `npm run dev:emulator` (vite --mode emulator). Talks to the local Firebase Emulator Suite with
# the demo project `demo-weinkeller` – no real Firebase project or credentials involved.
VITE_FIREBASE_USE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-weinkeller
# By default the app reaches the emulators through the Vite dev server (same origin, see vite.config.js),
# which works on localhost, on a phone in the LAN, and in GitHub Codespaces.
# Optional: connect directly to the emulator ports on this host instead.
# VITE_FIREBASE_EMULATOR_HOST=192.168.1.20
